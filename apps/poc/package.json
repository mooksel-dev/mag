{
  "name": "@mag/poc",
  "version": "0.0.0",
  "private": true,
  "description": "mag PoC desktop app: playground for ideas before they go into apps/desktop",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "test": "node --experimental-transform-types --no-warnings --test src/main/*.test.ts src/main/core/services/*/*.test.ts src/renderer/src/*.test.ts"
  },
  "dependencies": {
    "@mag/agents": "workspace:*",
    "@mag/arch": "workspace:*",
    "@mag/core": "workspace:*",
    "dompurify": "^3.4.17",
    "elkjs": "^0.12.1",
    "marked": "^16.4.2",
    "mermaid": "^12.2.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.17",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^37.10.3",
    "electron-vite": "^3.1.0",
    "react": "^19.1.10",
    "react-dom": "^19.1.10",
    "vite": "^6.4.5"
  }
