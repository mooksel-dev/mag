{
  "type": "component",
  "summary": "System level. The mobile app (lisa) talks only GraphQL to the gateway (coach-krupt graphql-layer at graph.aurasvc.io), which calls FTM REST. We add a third FTM app, ftm hub, that serves the Finance Hub tabs and computes recurring, card-on-file and alerts; the gateway gets a finance-hub entity proxying it; ingest changes to fetch deeper history, update transactions and keep connection health.",
  "boundaries": [
    {
      "id": "device",
      "name": "User device",
      "kind": "device"
    },
    {
      "id": "aura-ai",
      "name": "Aura AI",
      "kind": "runtime",
      "note": "account TBD"
    },
    {
      "id": "web-backend",
      "name": "AWS · Web Backend OU",
      "kind": "AWS accounts",
      "note": "aurasvc dev / test / prod · web-backend-plumbing"
    },
    {
      "id": "identity",
      "name": "AWS · Identity OU",
      "kind": "AWS accounts",
      "note": "identity dev / test / prod · identity-plumbing · us-east-1"
    },
    {
      "id": "identity-vpc",
      "name": "VPC · private subnets",
      "kind": "VPC",
      "parent": "identity"
    },
    {
      "id": "outside",
      "name": "Outside",
      "kind": "3rd party"
    }
  ],
  "flows": [
    {
      "id": "read",
      "name": "Tab read path",
      "note": "mobile → GraphQL gateway → FTM REST → hub API → DocumentDB",
      "diff": "add"
    },
    {
      "id": "ingest",
      "name": "Ingest path",
      "note": "Plaid → ingest → DynamoDB → SNS → SQS → populator and hub worker",
      "diff": "mod"
    },
    {
      "id": "alerts",
      "name": "Alerts",
      "note": "hub → SNS → AP → al-sneed; the SNS → AP bridge is a guess",
      "diff": "add"
    },
    {
      "id": "budget",
      "name": "Ask Aura budget tools",
      "note": "route TBD",
      "diff": "add"
    }
  ],
  "modules": [
    {
      "id": "lisa",
      "name": "Aura mobile app (lisa)",
      "kind": "React Native, RTK Query + GraphQL",
      "diff": "mod",
      "description": "New Finance Hub screens; query.gql + generated hooks, like the transactions feature.",
      "uses": [
        {
          "to": "graph-gateway",
          "calls": [
            {
              "text": "transactions(filters)"
            },
            {
              "text": "linkedFinancialItems()"
            },
            {
              "text": "financeHubOverview(month)"
            },
            {
              "text": "financeHubSpending()"
            },
            {
              "text": "financeHubIncome(month)"
            },
            {
              "text": "financeHubBills(pattern)"
            },
            {
              "text": "financeHubCardShield()"
            }
          ],
          "flow": "read",
          "step": "1"
        }
      ],
      "boundary": "device"
    },
    {
      "id": "ask-aura",
      "name": "Ask Aura",
      "kind": "chat agent",
      "description": "Builds the budget in chat.",
      "uses": [
        {
          "to": "ftm-hub",
          "calls": [
            {
              "text": "POST /ftm/hub/budget/proposal"
            }
          ],
          "diff": "add",
          "flow": "budget",
          "step": "1"
        }
      ],
      "boundary": "aura-ai"
    },
    {
      "id": "graph-gateway",
      "name": "API Gateway graph.aurasvc.io",
      "kind": "API Gateway",
      "boundary": "web-backend",
      "description": "Public GraphQL endpoint of the app.",
      "uses": [
        {
          "to": "graphql-layer",
          "calls": [
            {
              "text": "POST /graphql"
            }
          ],
          "flow": "read",
          "step": "2"
        }
      ]
    },
    {
      "id": "graphql-layer",
      "name": "GraphQL gateway (coach-krupt graphql-layer)",
      "kind": "type-graphql, graph.aurasvc.io",
      "diff": "mod",
      "description": "Existing TransactionsAPI datasource proxies /ftm. New: finance-hub entity + FinanceHubAPI datasource, thin pass-through.",
      "uses": [
        {
          "to": "identity-gateway",
          "calls": [
            {
              "text": "GET /ftm/hub/overview",
              "diff": "add"
            },
            {
              "text": "GET /ftm/hub/spending",
              "diff": "add"
            },
            {
              "text": "GET /ftm/hub/income",
              "diff": "add"
            },
            {
              "text": "GET /ftm/hub/bills",
              "diff": "add"
            },
            {
              "text": "GET /ftm/hub/card-shield",
              "diff": "add"
            },
            {
              "text": "GET /ftm/transactions"
            },
            {
              "text": "GET /ftm/items"
            }
          ],
          "flow": "read",
          "step": "3"
        }
      ],
      "boundary": "web-backend"
    },
    {
      "id": "al-sneed",
      "name": "al-sneed",
      "kind": "Lambdas + SQS feed_ingest",
      "uses": [],
      "description": "Push and feed notifications.",
      "boundary": "web-backend",
      "diff": "mod"
    },
    {
      "id": "identity-gateway",
      "name": "API Gateway identity.aurasvc.io/ftm",
      "kind": "API Gateway",
      "boundary": "identity",
      "description": "CUSTOM authorizer (JWT); the Plaid webhook route has no auth.",
      "uses": [
        {
          "to": "ftm-hub",
          "calls": [
            {
              "text": "GET /ftm/hub/*"
            }
          ],
          "diff": "add",
          "flow": "read",
          "step": "4"
        },
        {
          "to": "ftm-query",
          "calls": [
            {
              "text": "GET /ftm/transactions"
            }
          ]
        },
        {
          "to": "ftm-ingest",
          "calls": [
            {
              "text": "GET /ftm/items"
            },
            {
              "text": "POST /ftm/items/webhook"
            }
          ],
          "flow": "ingest",
          "step": "B"
        }
      ]
    },
    {
      "id": "ftm-ingest",
      "name": "ftm ingest (existing)",
      "kind": "Lambda",
      "diff": "mod",
      "description": "Plaid link and webhooks. Changes: 730 days history, /transactions/sync, item health.",
      "interface": [
        {
          "text": "linkItem(publicToken): Item - requests 730 days",
          "diff": "mod"
        },
        {
          "text": "syncTransactions(itemId): void - added, modified, removed",
          "diff": "add"
        },
        {
          "text": "onItemWebhook(payload): void - keeps errorCode and lastSuccessfulUpdate",
          "diff": "mod"
        }
      ],
      "uses": [
        {
          "to": "plaid",
          "calls": [
            {
              "text": "/transactions/get"
            },
            {
              "text": "/transactions/sync",
              "diff": "add"
            }
          ],
          "diff": "mod",
          "flow": "ingest",
          "step": "C"
        },
        {
          "to": "dynamodb",
          "calls": [
            {
              "text": "write events and item view"
            }
          ],
          "flow": "ingest",
          "step": "D"
        }
      ],
      "boundary": "identity"
    },
    {
      "id": "ftm-query",
      "name": "ftm query (existing)",
      "kind": "Lambda",
      "diff": "mod",
      "description": "Keeps ftm.transactions; legacy transaction list. Change: applies modified events.",
      "uses": [
        {
          "to": "documentdb",
          "calls": [
            {
              "text": "upsert ftm.transactions"
            }
          ],
          "flow": "ingest",
          "step": "H"
        }
      ],
      "boundary": "identity-vpc"
    },
    {
      "id": "ftm-alert",
      "name": "ftm alert (existing)",
      "kind": "Lambda",
      "boundary": "identity",
      "description": "Legacy threshold alerts; unchanged.",
      "uses": [
        {
          "to": "dynamodb",
          "calls": [
            {
              "text": "read thresholds-config"
            }
          ]
        }
      ]
    },
    {
