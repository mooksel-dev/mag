{
  "type": "component",
  "summary": "System level. The mobile app (mobile-app) talks only GraphQL to the gateway (gateway-repo graphql-layer at graph.acme.example), which calls FIN REST. We add a third FIN app, fin hub, that serves the Money Hub tabs and computes recurring, card-on-file and alerts; the gateway gets a money-hub entity proxying it; ingest changes to fetch deeper history, update transactions and keep connection health.",
  "boundaries": [
    {
      "id": "device",
      "name": "User device",
      "kind": "device"
    },
    {
      "id": "acme-ai",
      "name": "Acme AI",
      "kind": "runtime",
      "note": "account TBD"
    },
    {
      "id": "web-backend",
      "name": "AWS · Web Backend OU",
      "kind": "AWS accounts",
      "note": "acme dev / test / prod · web-backend-infra"
    },
    {
      "id": "identity",
      "name": "AWS · Identity OU",
      "kind": "AWS accounts",
      "note": "identity dev / test / prod · identity-infra · us-east-1"
    },
    {
      "id": "identity-vpc",
      "name": "VPC · private subnets",
      "kind": "VPC",
      "parent": "identity"
    },
    {
      "id": "outside",
      "name": "Outside",
      "kind": "3rd party"
    }
  ],
  "flows": [
    {
      "id": "read",
      "name": "Tab read path",
      "note": "mobile → GraphQL gateway → FIN REST → hub API → DocumentDB",
      "diff": "add"
    },
    {
      "id": "ingest",
      "name": "Ingest path",
      "note": "BankLink → ingest → DynamoDB → SNS → SQS → populator and hub worker",
      "diff": "mod"
    },
    {
      "id": "alerts",
      "name": "Alerts",
      "note": "hub → SNS → AP → notifier; the SNS → AP bridge is a guess",
      "diff": "add"
    },
    {
      "id": "budget",
      "name": "Ask Acme budget tools",
      "note": "route TBD",
      "diff": "add"
    }
  ],
  "modules": [
    {
      "id": "mobile-app",
      "name": "Acme mobile app (mobile-app)",
      "kind": "React Native, RTK Query + GraphQL",
      "diff": "mod",
      "description": "New Money Hub screens; query.gql + generated hooks, like the transactions feature.",
      "uses": [
        {
          "to": "graph-gateway",
          "calls": [
            {
              "text": "transactions(filters)"
            },
            {
              "text": "linkedFinancialItems()"
            },
            {
              "text": "moneyHubOverview(month)"
            },
            {
              "text": "moneyHubSpending()"
            },
            {
              "text": "moneyHubIncome(month)"
            },
            {
              "text": "moneyHubBills(pattern)"
            },
            {
              "text": "moneyHubCardGuard()"
            }
          ],
          "flow": "read",
          "step": "1"
        }
      ],
      "boundary": "device"
    },
    {
      "id": "ask-acme",
      "name": "Ask Acme",
      "kind": "chat agent",
      "description": "Builds the budget in chat.",
      "uses": [
        {
          "to": "fin-hub",
          "calls": [
            {
              "text": "POST /fin/hub/budget/proposal"
            }
          ],
          "diff": "add",
          "flow": "budget",
          "step": "1"
        }
      ],
      "boundary": "acme-ai"
    },
    {
      "id": "graph-gateway",
      "name": "API Gateway graph.acme.example",
      "kind": "API Gateway",
      "boundary": "web-backend",
      "description": "Public GraphQL endpoint of the app.",
      "uses": [
        {
          "to": "graphql-layer",
          "calls": [
            {
              "text": "POST /graphql"
            }
          ],
          "flow": "read",
          "step": "2"
        }
      ]
    },
    {
      "id": "graphql-layer",
      "name": "GraphQL gateway (gateway-repo graphql-layer)",
      "kind": "type-graphql, graph.acme.example",
      "diff": "mod",
      "description": "Existing TransactionsAPI datasource proxies /fin. New: money-hub entity + MoneyHubAPI datasource, thin pass-through.",
      "uses": [
        {
          "to": "identity-gateway",
          "calls": [
            {
              "text": "GET /fin/hub/overview",
              "diff": "add"
            },
            {
              "text": "GET /fin/hub/spending",
              "diff": "add"
            },
            {
              "text": "GET /fin/hub/income",
              "diff": "add"
            },
            {
              "text": "GET /fin/hub/bills",
              "diff": "add"
            },
            {
              "text": "GET /fin/hub/card-guard",
              "diff": "add"
            },
            {
              "text": "GET /fin/transactions"
            },
            {
              "text": "GET /fin/items"
            }
          ],
          "flow": "read",
          "step": "3"
        }
      ],
      "boundary": "web-backend"
    },
    {
      "id": "notifier",
      "name": "notifier",
      "kind": "Lambdas + SQS feed_ingest",
      "uses": [],
      "description": "Push and feed notifications.",
      "boundary": "web-backend",
      "diff": "mod"
    },
    {
      "id": "identity-gateway",
      "name": "API Gateway identity.acme.example/fin",
      "kind": "API Gateway",
      "boundary": "identity",
      "description": "CUSTOM authorizer (JWT).",
      "uses": [
        {
          "to": "fin-hub",
          "calls": [
            {
              "text": "GET /fin/hub/*"
            }
          ],
          "diff": "add",
          "flow": "read",
          "step": "4"
        },
        {
          "to": "fin-query",
          "calls": [
            {
              "text": "GET /fin/transactions"
            }
          ]
        },
        {
          "to": "fin-ingest",
          "calls": [
            {
              "text": "GET /fin/items"
            },
            {
              "text": "POST /fin/items/webhook"
            }
          ],
          "flow": "ingest",
          "step": "B"
        }
      ]
    },
    {
      "id": "fin-ingest",
      "name": "fin ingest (existing)",
      "kind": "Lambda",
      "diff": "mod",
      "description": "BankLink link and webhooks. Changes: 730 days history, /transactions/sync, item health.",
      "interface": [
        {
          "text": "linkItem(publicToken): Item - requests 730 days",
          "diff": "mod"
        },
        {
          "text": "syncTransactions(itemId): void - added, modified, removed",
          "diff": "add"
        },
        {
          "text": "onItemWebhook(payload): void - keeps errorCode and lastSuccessfulUpdate",
          "diff": "mod"
        }
      ],
      "uses": [
        {
          "to": "banklink",
          "calls": [
            {
              "text": "/transactions/get"
            },
            {
              "text": "/transactions/sync",
              "diff": "add"
            }
          ],
          "diff": "mod",
          "flow": "ingest",
          "step": "C"
        },
        {
          "to": "dynamodb",
          "calls": [
            {
              "text": "write events and item view"
            }
          ],
          "flow": "ingest",
          "step": "D"
        }
      ],
      "boundary": "identity"
    },
    {
      "id": "fin-query",
      "name": "fin query (existing)",
      "kind": "Lambda",
      "diff": "mod",
      "description": "Keeps fin.transactions; legacy transaction list. Change: applies modified events.",
      "uses": [
        {
          "to": "documentdb",
          "calls": [
            {
              "text": "upsert fin.transactions"
            }
          ],
          "flow": "ingest",
          "step": "H"
        }
      ],
      "boundary": "identity-vpc"
    },
    {
      "id": "fin-alert",
      "name": "fin alert (existing)",
      "kind": "Lambda",
      "boundary": "identity",
      "description": "Legacy threshold alerts; unchanged.",
      "uses": [
        {
          "to": "dynamodb",
          "calls": [
            {
              "text": "read thresholds-config"
            }
          ]
        }
      ]
    },
